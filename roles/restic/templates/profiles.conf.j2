# vim: ft=toml

# Scheduling is NOT handled here. The restic role deploys its own
# resticprofile-backup-<name>.{service,timer} units (see roles/restic/templates
# and tasks/schedule.yml), so resticprofile's own `schedule*` keys are
# deliberately absent — setting them would create a second, competing set of
# timers via `resticprofile schedule`.

version = "1"

[global]
  restic-binary = "{{ restic_home }}/bin/restic"
  password-file = "{{ restic_home }}/.config/resticprofile/repo.key"

  [global.backup]
    exclude-caches = true
    exclude-file = "{{ restic_home }}/.config/resticprofile/excludes"
    exclude-if-present = [".nobackup"]
    one-file-system = true
    source = ["/etc", "/home"]

  # Consumed only by an on-demand `resticprofile --name <name> check`.
  [global.check]
    read-data = true

  [global.forget]
    after-backup = true
    keep-daily = 7
    keep-hourly = 12
    keep-monthly = 24
    keep-weekly = 8
    prune = false

[groups]
  all = ["nas", "b2"]

[nas]
  inherit = "global"
  lock = "/tmp/resticprofile-nas.lock"
  repository = "{{ restic_repo_nas }}"

[b2]
  inherit = "global"
  lock = "/tmp/resticprofile-b2.lock"
  repository = "{{ restic_repo_b2 }}"

  [b2.env]
    B2_ACCOUNT_ID = "{{ b2_account_id }}"
    B2_ACCOUNT_KEY = "{{ b2_account_key }}"
