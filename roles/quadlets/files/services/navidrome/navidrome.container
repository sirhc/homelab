[Unit]
Description=Navidrome
Documentation=https://www.navidrome.org/docs/

[Service]
ExecStartPre=mkdir -p %D/%N/plugins
# Fetch the AudioMuse-AI sonic similarity plugin (pinned). Leading '-' keeps Navidrome
# starting if GitHub is unreachable; any previously downloaded copy stays in place.
ExecStartPre=-curl -fsSL -o %D/%N/plugins/audiomuseai.ndp https://github.com/NeptuneHub/AudioMuse-AI-NV-plugin/releases/download/v10/audiomuseai.ndp

[Container]

EnvironmentFile=./%N.env

HostName=%N

Image=docker.io/deluan/navidrome:latest

Label=traefik.enable=true
Label=traefik.http.routers.%N.rule=Host'(`%N.${DOMAIN}`)'
Label=traefik.http.services.%N.loadbalancer.server.port=4533

Network=homelab.network

Volume=/etc/localtime:/etc/localtime:ro
Volume=/media/Music:/music:ro
Volume=%D/%N:/data:Z

[Install]
WantedBy=default.target
