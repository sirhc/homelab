[Unit]
Description=Hister
Documentation=https://hister.org/docs/

[Service]
ExecStartPre=mkdir -p %D/%N

[Container]

Environment=HISTER__SERVER__BASE_URL=https://%N.${DOMAIN}

HostName=%N

Image=ghcr.io/asciimoo/hister:latest

Label=traefik.enable=true
Label=traefik.http.routers.%N.rule=Host'(`%N.${DOMAIN}`)'
Label=traefik.http.services.%N.loadbalancer.server.port=4433

Network=homelab.network

Volume=/etc/localtime:/etc/localtime:ro
Volume=%D/%N:/hister/data:Z,U

[Install]
WantedBy=default.target
