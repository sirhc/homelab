[Unit]
Description=Radicale
Documentation=https://radicale.org/v3.html

[Container]

HostName=%N

Image=docker.io/tomsquest/docker-radicale:latest

Label=traefik.enable=true
Label=traefik.http.routers.%N.rule=Host'(`%N.${DOMAIN}`)'
Label=traefik.http.services.%N.loadbalancer.server.port=5232

Network=homelab.network

# The entrypoint chowns /data to the radicale user (UID 2999) and drops to it.
Volume=/etc/localtime:/etc/localtime:ro
Volume=%E/%N:/config:ro,Z
Volume=radicale.volume:/data:Z

[Install]
WantedBy=default.target
