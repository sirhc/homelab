[Unit]
Description=tududi PostgreSQL
Documentation=https://github.com/chrisvel/tududi/blob/main/docs/16-postgresql.md

[Container]

ContainerName=%N
HostName=%N

Image=docker.io/library/postgres:16-alpine

EnvironmentFile=./%N.env

Network=homelab.network

Volume=/etc/localtime:/etc/localtime:ro
Volume=tududi-postgres.volume:/var/lib/postgresql/data:Z

[Install]
WantedBy=default.target
