[Unit]
Description=tududi
Documentation=https://docs.tududi.com/
After=tududi-postgres.service
Requires=tududi-postgres.service

[Container]

# Environment=TUDUDI_USER_EMAIL=...
# Environment=TUDUDI_USER_PASSWORD=...
# Environment=TUDUDI_SESSION_SECRET=...
# Environment=TUDUDI_ALLOWED_ORIGINS=...
# Environment=DATABASE_URL=...
EnvironmentFile=./%N.env

HostName=%N

Image=docker.io/chrisvel/tududi:latest

Label=traefik.enable=true
Label=traefik.http.routers.%N.rule=Host'(`todo.${DOMAIN}`)'
Label=traefik.http.services.%N.loadbalancer.server.port=3002

Network=homelab.network

Volume=/etc/localtime:/etc/localtime:ro
# 2.0 moved these out of /app/backend and keeps its data in tududi-postgres.
Volume=tududi-uploads.volume:/app/uploads:Z
Volume=tududi-backups.volume:/app/backups:Z

[Install]
WantedBy=default.target
