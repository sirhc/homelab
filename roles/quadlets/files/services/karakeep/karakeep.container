[Unit]
Description=Karakeep
Documentation=https://docs.karakeep.app/
After=karakeep-meilisearch.service karakeep-chrome.service

[Container]

HostName=%N

Image=ghcr.io/karakeep-app/karakeep:release

# karakeep-chrome's devtools port is IPv4-only (socat TCP4-LISTEN); without this,
# Node resolves the container's AAAA record first and connectOverCDP fails.
Environment=NODE_OPTIONS=--dns-result-order=ipv4first

EnvironmentFile=./%N.env

Label=traefik.enable=true
Label=traefik.http.routers.%N.rule=Host'(`keep.${DOMAIN}`)'
Label=traefik.http.services.%N.loadbalancer.server.port=3000

Network=homelab.network

Volume=/etc/localtime:/etc/localtime:ro
Volume=karakeep.volume:/data:Z

[Install]
WantedBy=default.target
