[Unit]
Description=AudioMuse-AI
Documentation=https://github.com/NeptuneHub/AudioMuse-AI
After=audiomuse-postgres.service
Requires=audiomuse-postgres.service

[Container]

ContainerName=%N
HostName=%N

Image=ghcr.io/neptunehub/audiomuse-ai:latest

EnvironmentFile=./%N.env

Label=traefik.enable=true
Label=traefik.http.routers.%N.rule=Host'(`%N.${DOMAIN}`)'
Label=traefik.http.services.%N.loadbalancer.server.port=8000

Network=homelab.network

Volume=/etc/localtime:/etc/localtime:ro
Volume=audiomuse.volume:/app/temp_audio:Z

[Install]
WantedBy=default.target
